# A dependency's install script runs as whoever ran the install, and here that
# is the release job — a step carrying GITHUB_TOKEN with contents: write, whose
# `npm ci` writes web/dist, which `//go:embed all:dist` then compiles into all
# four published binaries. One postinstall in any of the 368 installed packages
# would hold both the release credential and the bundle an operator afterwards
# types a swarm-root bearer token into.
#
# check-npm-licences.sh does not cover this: it runs after the install and reads
# licence fields, not code.
#
# This file is the half that covers an invocation nobody remembered to flag,
# including a developer's own `npm ci`. Every `npm ci` this repository runs also
# passes --ignore-scripts explicitly and check-npm-scripts.sh fails if one does
# not, because which .npmrc npm reads as the project's is a resolution rule and
# every one of those invocations is --prefixed from another directory.
#
# If a package ever genuinely needs its script, allow that one package rather
# than turning this off.
ignore-scripts=true
